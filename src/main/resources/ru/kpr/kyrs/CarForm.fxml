<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="titleLabel"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"
           text="%car.title" />

    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" hgrow="NEVER" prefWidth="120" />
            <ColumnConstraints hgrow="ALWAYS" prefWidth="300" />
        </columnConstraints>

        <Label text="%car.marka" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="markaField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="%car.model" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="modelField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="%car.gosNumber" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="gosNumberField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="%car.year" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="yearField" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="%car.vin" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="vinNumberField" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <Label text="%car.insurance" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <TextField fx:id="insuranceField" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <Label text="%car.condition" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <ComboBox fx:id="conditionComboBox"
                  promptText="%car.condition.prompt"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="6" />

        <Label text="%car.capacity" GridPane.columnIndex="0" GridPane.rowIndex="7" />
        <TextField fx:id="capacityField" GridPane.columnIndex="1" GridPane.rowIndex="7" />

        <Label text="%car.fuelNorm" GridPane.columnIndex="0" GridPane.rowIndex="8" />
        <TextField fx:id="fuelNormField"
                   promptText="%car.fuelNorm.prompt"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="8" />
    </GridPane>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="btnSave"
                onAction="#save"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white;"
                text="%button.save" />

        <Button fx:id="btnCancel"
                onAction="#cancel"
                text="%button.cancel" />
    </HBox>

</VBox>