<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="titleLabel"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"
           text="%repair.title" />

    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" hgrow="NEVER" prefWidth="120" />
            <ColumnConstraints hgrow="ALWAYS" prefWidth="300" />
        </columnConstraints>

        <Label text="%repair.car" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="carComboBox"
                  promptText="%repair.car.prompt"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="0" />

        <Label text="%repair.date" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <DatePicker fx:id="repairDatePicker"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="1" />

        <Label text="%repair.mechanic" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <ComboBox fx:id="mechanicComboBox"
                  promptText="%repair.mechanic.prompt"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="2" />

        <Label text="%repair.result" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextArea fx:id="resultArea"
                  prefHeight="80.0"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="3" />
    </GridPane>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="btnSave"
                onAction="#save"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white;"
                text="%button.save" />

        <Button fx:id="btnCancel"
                onAction="#cancel"
                text="%button.cancel" />
    </HBox>

</VBox>